---
import { getCollection as getPrompts } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';
import { collections } from '../../lib/collections';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  return collections.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collection = collections.find(c => c.slug === slug)!;
const allPrompts = await getPrompts('prompts');
const filtered = allPrompts.filter(p => collection.promptSlugs.includes(p.slug));
---
<BaseLayout title={collection.title}>
  <div class="container" style="padding: 24px 20px 48px;">
    <p class="breadcrumb"><a href={withBase('/')}>Home</a> / <span>Collections</span> / <span>{collection.title}</span></p>
    <h1>{collection.title}</h1>
    <p>{collection.description}</p>
    <div class="card-grid">
      {filtered.map(p => (
        <PromptCard
          slug={p.slug}
          title={p.data.title}
          purpose={p.data.purpose}
          category={p.data.category}
          tags={p.data.tags}
          sequence={p.data.sequence}
          sequenceStep={p.data.sequence_step}
          sequenceTotal={allPrompts.filter(x => x.data.sequence === p.data.sequence).length}
          hasExample={!!p.data.example_output}
          updated={p.data.updated}
        />
      ))}
    </div>
  </div>
</BaseLayout>
