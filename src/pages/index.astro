---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptCard from '../components/PromptCard.astro';
import { getAllSequenceSlugs } from '../lib/sequences';
import { CATEGORIES } from '../content/config';
import { withBase } from '../lib/url';

const prompts = await getCollection('prompts');
const sequenceSlugs = getAllSequenceSlugs(prompts);

const categoryCounts = CATEGORIES.map(cat => ({
  slug: cat,
  count: prompts.filter(p => p.data.category === cat).length
})).filter(c => c.count > 0);

const useCaseTiles = [
  { label: 'Debugging', tag: 'debug' },
  { label: 'First drafts', tag: 'draft' },
  { label: 'Summarizing', tag: 'summarize' },
  { label: 'Translating', tag: 'translate' }
];

const recent = [...prompts]
  .sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0))
  .slice(0, 8);
---
<BaseLayout title="Home">
  <section class="container" style="padding: 32px 20px 8px;">
    <h1>Prompt Library</h1>
    <p style="font-family: var(--mono); font-size: 13px; color: var(--ink-faint);">
      {prompts.length} prompts across {categoryCounts.length} categories, organized into {sequenceSlugs.length} sequences.
    </p>
  </section>

  <section class="container" style="padding: 16px 20px;">
    <h2 style="margin-bottom: 12px;">Browse by category</h2>
    <div class="card-grid">
      {categoryCounts.map(c => (
        <a href={withBase(`/browse/${c.slug}`)} class="surface prompt-card" style="align-items: flex-start;">
          <span class="card-title" style="text-transform: capitalize;">{c.slug.replace('-', ' ')}</span>
          <span class="card-footer"><span>{c.count} prompts</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container" style="padding: 16px 20px;">
    <h2 style="margin-bottom: 12px;">Browse by use case</h2>
    <div class="card-grid">
      {useCaseTiles.map(t => (
        <a href={withBase(`/tag/${t.tag}`)} class="surface prompt-card" style="align-items: flex-start;">
          <span class="card-title">{t.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container" style="padding: 16px 20px;">
    <h2 style="margin-bottom: 12px;">Recently added</h2>
    <div class="card-grid">
      {recent.map(p => (
        <PromptCard
          slug={p.slug}
          title={p.data.title}
          purpose={p.data.purpose}
          category={p.data.category}
          tags={p.data.tags}
          sequence={p.data.sequence}
          sequenceStep={p.data.sequence_step}
          sequenceTotal={prompts.filter(x => x.data.sequence === p.data.sequence).length}
          hasExample={!!p.data.example_output}
          updated={p.data.updated}
        />
      ))}
    </div>
  </section>

  <section class="container" style="padding: 24px 20px 48px; text-align: center;">
    <p style="font-size: 13px;">Adding a prompt is just a file. See <a href={withBase('/contributing')} style="color: var(--accent);">Adding a Prompt</a>.</p>
  </section>
</BaseLayout>
