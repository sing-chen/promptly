---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptCard from '../components/PromptCard.astro';
import { withBase } from '../lib/url';

const allPrompts = await getCollection('prompts');
const favoritesScriptUrl = withBase('/scripts/favorites.js');
---
<BaseLayout title="Favorites">
  <div class="container" style="padding: 24px 20px 48px;">
    <h1 style="margin-bottom: 16px;">Favorites</h1>

    <div id="favorites-empty" hidden>
      <p>Nothing starred yet. <a href={withBase('/browse')} style="color: var(--accent);">Browse prompts</a> to find one worth keeping.</p>
    </div>

    <button class="btn btn-secondary" id="export-favs" style="margin-bottom: 16px;">Export favorites (JSON)</button>

    <div class="card-grid" id="favorites-grid">
      {allPrompts.map(p => (
        <div class="fav-item" data-slug={p.slug} hidden>
          <PromptCard
            slug={p.slug}
            title={p.data.title}
            purpose={p.data.purpose}
            category={p.data.category}
            tags={p.data.tags}
            sequence={p.data.sequence}
            sequenceStep={p.data.sequence_step}
            sequenceTotal={allPrompts.filter(x => x.data.sequence === p.data.sequence).length}
            hasExample={!!p.data.example_output}
            updated={p.data.updated}
          />
        </div>
      ))}
    </div>
  </div>

  <script type="module" define:vars={{ favoritesScriptUrl }}>
    const { getFavorites, exportFavorites } = await import(/* @vite-ignore */ favoritesScriptUrl);

    function render() {
      const favs = new Set(getFavorites());
      const items = document.querySelectorAll('.fav-item');
      let visible = 0;
      items.forEach(item => {
        const match = favs.has(item.dataset.slug);
        item.hidden = !match;
        if (match) visible++;
      });
      document.getElementById('favorites-empty').hidden = visible > 0;
    }

    document.getElementById('export-favs').addEventListener('click', exportFavorites);
    document.addEventListener('favorites:changed', render);
    render();
  </script>
</BaseLayout>
