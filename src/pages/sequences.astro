---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllSequenceSlugs, getSequenceSteps } from '../lib/sequences';
import { withBase } from '../lib/url';

const prompts = await getCollection('prompts');
const seqSlugs = getAllSequenceSlugs(prompts);
const sequences = seqSlugs.map(slug => ({
  slug,
  steps: getSequenceSteps(prompts, slug)
}));
---
<BaseLayout title="Sequences">
  <div class="container" style="padding: 24px 20px 48px;">
    <h1 style="margin-bottom: 8px;">Sequences</h1>
    <p>Multi-step prompt chains. Every step also works as a standalone prompt.</p>

    {sequences.length === 0 && <p>No sequences yet.</p>}

    {sequences.map(seq => (
      <section style="margin: 32px 0;">
        <h2 style="text-transform: capitalize; margin-bottom: 4px;">{seq.slug.replace(/-/g, ' ')}</h2>
        <a href={withBase(`/sequence/${seq.slug}`)} style="font-size: 13px; color: var(--accent);">View sequence page →</a>
        <div class="seq-flow" style="margin-top: 12px;">
          {seq.steps.map((step, i) => (
            <>
              <a class="seq-step-card surface" href={withBase(`/prompt/${step.slug}`)}>
                <div class="chip chip-seq" style="margin-bottom: 8px;">step {step.data.sequence_step} of {seq.steps.length}</div>
                <div class="card-title">{step.data.title}</div>
              </a>
              {i < seq.steps.length - 1 && <span class="seq-connector">→</span>}
            </>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
