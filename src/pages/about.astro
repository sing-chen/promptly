---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About">
  <div class="container" style="padding: 24px 20px 48px; max-width: 720px;">
    <h1 style="margin-bottom: 12px;">About</h1>
    <p>Prompt Library is a personal, single-user catalog of AI prompts. It's a static site — no accounts, no backend, no database. Every prompt lives as a Markdown file with YAML frontmatter in <code>/prompts</code>, and the whole site is rebuilt from that folder.</p>
    <p>Favorites are stored locally in your browser via <code>localStorage</code> — nothing is synced anywhere.</p>
  </div>
</BaseLayout>
