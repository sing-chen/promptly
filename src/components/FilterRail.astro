---
interface Props {
  models: string[];
  activeModel?: string;
  activeComplexity?: string;
  activeChain?: 'all' | 'sequenced';
}
const { models, activeModel, activeComplexity, activeChain = 'all' } = Astro.props;
const complexities = ['simple', 'multi-step', 'agentic'];
---
<aside class="filter-rail well">
  <div class="filter-group">
    <h3>Model</h3>
    <a class={`filter-option ${!activeModel ? 'is-active' : ''}`} href="?">All models</a>
    {models.map(m => (
      <a class={`filter-option ${activeModel === m ? 'is-active' : ''}`} href={`?model=${m}`}>{m}</a>
    ))}
  </div>
  <div class="filter-group">
    <h3>Complexity</h3>
    <a class={`filter-option ${!activeComplexity ? 'is-active' : ''}`} href="?">All</a>
    {complexities.map(c => (
      <a class={`filter-option ${activeComplexity === c ? 'is-active' : ''}`} href={`?complexity=${c}`}>{c}</a>
    ))}
  </div>
  <div class="filter-group">
    <h3>Chain</h3>
    <a class={`filter-option ${activeChain === 'all' ? 'is-active' : ''}`} href="?">All prompts</a>
    <a class={`filter-option ${activeChain === 'sequenced' ? 'is-active' : ''}`} href="?chain=sequenced">In a sequence only</a>
  </div>
</aside>
